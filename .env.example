# Copy to .env and fill in your own values. Never commit .env (it is gitignored).
# Every value below is a placeholder; the app refuses to start with placeholder secrets.

# --- Mode --------------------------------------------------------------------
# personal (default): your own database and Google sign-in.
# demo: synthetic data only, localhost only, no Google account or OpenAI key needed
#   (see README "Demo Mode"). In demo mode PUBLIC_BASE_URL must be http://localhost[:port],
#   TEST_AUTH must be 0, the Google settings and DATABASE_PATH are not used, and
#   SESSION_SECRET may be left empty.
APP_MODE=personal

# --- Required now -----------------------------------------------------------
# Random secret for signing session cookies (64 hex chars). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Demo mode: leave it empty to get a random secret per run.
SESSION_SECRET=replace-me

# Public origin of the app: http://localhost:8000 locally, or the https tunnel URL
# printed by scripts/start.ps1. No path, no trailing slash.
PUBLIC_BASE_URL=http://localhost:8000

# SQLite database file (created on first run; the data/ folder is gitignored).
DATABASE_PATH=data/app.db

# --- Google sign-in --------------------------------------------------------
# OAuth 2.0 "Web application" client from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google account emails allowed to sign in for the first time
# (yours; keep it only in .env).
ALLOWED_EMAILS=

# --- OpenAI (analytics agent, B-15) -----------------------------------------
# AI features run only when AI_ENABLED=1 and both values below are set; otherwise the
# Analyst tab explains that AI is not configured and everything else works normally.
AI_ENABLED=1
OPENAI_API_KEY=
# A model that supports function calling and structured outputs (no web search needed).
OPENAI_MODEL=
# Per-question token budget and per-user hourly question cap (ADR-005 §3.5).
AI_MAX_TOKENS_PER_QUESTION=40000
AI_QUESTIONS_PER_HOUR=20

# --- Testing only ------------------------------------------------------------
# 1 enables a fake login for automated browser tests (use a separate DATABASE_PATH).
# Refused unless PUBLIC_BASE_URL is localhost.
TEST_AUTH=0
